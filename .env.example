# ==============================================================================
# SofraPOS — Ortam Değişkenleri (.env.example)
# Kullanım: cp .env.example .env && docker compose up --build
# ==============================================================================

# --- Genel ---
APP_ENV=production
APP_VERSION=1.0.0

# --- PostgreSQL 16 (Sadece Docker Compose iç ağında erişilir) ---
POSTGRES_USER=ddo_user
POSTGRES_PASSWORD=ddo_secret_password_2026
POSTGRES_DB=ddo_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5

# --- Backend (Go + Fiber) ---
BACKEND_PORT=8080
DATABASE_URL=postgres://ddo_user:ddo_secret_password_2026@postgres:5432/ddo_db?sslmode=disable
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=sofrapos-super-secret-jwt-key-2026-cc6433

# --- Veri Üretici (Simülatör) ---
SIMULATOR_SEED=42
SIMULATOR_INTERVAL_SEC=6

# --- Frontend (SvelteKit + adapter-node) ---
FRONTEND_PORT=3000
ORIGIN=http://localhost:3000
INTERNAL_API_URL=http://backend:8080
PUBLIC_API_URL=http://localhost:8080
